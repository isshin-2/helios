# ==============================================================================
# HELIOS Ecosystem — Environment Configuration Template
# Copy this file to ai-router/.env (or run setup.bat / setup.sh / python helios.py --setup)
# ==============================================================================

DEPLOYMENT_MODE=local
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
PAIR_HOST=http://127.0.0.1:11434

AI_PC_IP=127.0.0.1
AI_PC_MAC=
AI_PC_BROADCAST=255.255.255.255
AI_PC_WAKE_SCRIPT=
AUTO_WAKE_AI_PC=false

VISION_MODEL=moondream:latest

BOT_NAME=HELIOS
USER_NAME=User
WAKE_WORD=helios
PERSONALITY=helpful, professional, and concise

SERVER_PORT=8000
CHARACTER_PORT=8080

VOICE_ENABLED=true
VOICE_BACKEND=kokoro
VOICE_NAME=af_heart
VOICE_SPEED=1.0

ENABLE_DESKTOP_APP=false
ENABLE_HOT_MIC=false

GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
