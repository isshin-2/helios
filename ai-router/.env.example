# ==============================================================================
# HELIOS Ecosystem — Environment Configuration Template
# Copy this file to .env (or run setup.bat / setup.sh / python helios.py --setup)
# ==============================================================================

# Operation Mode: 'local' (offline), 'hybrid' (local + cloud fallback), 'online' (cloud only)
DEPLOYMENT_MODE=local

# Primary LLM Provider: 'ollama', 'pair' (dedicated GPU workstation), 'vllm', 'gemini', 'openrouter'
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
PAIR_HOST=http://127.0.0.1:11434

# Dedicated AI PC Workstation Node (optional, leave default if running single-machine)
AI_PC_IP=127.0.0.1
AI_PC_MAC=
AI_PC_BROADCAST=255.255.255.255
AI_PC_WAKE_SCRIPT=
AUTO_WAKE_AI_PC=false

# Vision Model for UI grounding and computer control (e.g. moondream:latest, qwen3-vl:8b)
VISION_MODEL=moondream:latest

# Identity & Personalization
BOT_NAME=HELIOS
USER_NAME=User
WAKE_WORD=helios
PERSONALITY=helpful, professional, and concise

# Network Ports
SERVER_PORT=8000
CHARACTER_PORT=8080

# Neural Voice & Speech Synthesis
VOICE_ENABLED=true
VOICE_BACKEND=kokoro
VOICE_NAME=af_heart
VOICE_SPEED=1.0

# Desktop & Interaction
ENABLE_DESKTOP_APP=false
ENABLE_HOT_MIC=false

# Optional Cloud API Keys (required only if using cloud escalation or online mode)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
